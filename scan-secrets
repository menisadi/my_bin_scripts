#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# scan-secrets — scan every git repo under a directory for leaked secrets in
# the FULL git history (all commits/blobs), using gitleaks. Detection only;
# never rewrites history.

_warn() { printf '%s\n' "$*" >&2; }
_die() { _warn "$@"; exit 1; }

MAX_DEPTH="${SCAN_MAX_DEPTH:-4}"

usage() {
  cat <<EOF
Usage: $(basename "${0}") [BASE_DIR]

  BASE_DIR     Directory to scan for git repos (default: current directory).

  -h, --help   Show this help.

Environment:
  SCAN_MAX_DEPTH   Max directory depth to search for repos (default: 4).

Exit status: 0 clean, 1 findings present, 2 setup error.
Per-repo JSON reports are written under a temp dir (path printed at the end).
EOF
}

base_dir="${PWD}"
while [[ $# -gt 0 ]]; do
  case "${1}" in
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      _die "Unknown option: ${1}"
      ;;
    *)
      base_dir="${1}"
      shift
      ;;
  esac
done

command -v gitleaks >/dev/null 2>&1 || _die "gitleaks not found (brew install gitleaks)"
[[ -d "${base_dir}" ]] || { usage >&2; _die "Not a directory: ${base_dir}"; }
base_dir="$(cd "${base_dir}" && pwd)"

# Prefer fd for discovery; fall back to POSIX find.
_find_repos() {
  if command -v fd >/dev/null 2>&1; then
    fd -H -t d -d "${MAX_DEPTH}" '^\.git$' "${base_dir}"
  else
    find "${base_dir}" -maxdepth "${MAX_DEPTH}" -type d -name .git
  fi
}

report_dir="$(mktemp -d "${TMPDIR:-/tmp}/gitleaks-scan.XXXXXX")"
total_findings=0
repos_with_findings=0
repos_scanned=0

printf '%-50s %s\n' "REPO" "FINDINGS"
printf '%-50s %s\n' "----" "--------"

while IFS= read -r git_dir; do
  repo_dir="${git_dir%/}"        # fd appends a trailing slash to dirs
  repo_dir="${repo_dir%/.git}"
  repo_name="${repo_dir#"${base_dir}"/}"
  safe_name="${repo_name//\//__}"
  report_file="${report_dir}/${safe_name}.json"

  gitleaks git "${repo_dir}" \
    --report-format json --report-path "${report_file}" \
    --exit-code 0 --no-banner \
    >/dev/null 2>"${report_dir}/${safe_name}.err" || true

  # gitleaks writes a JSON array; count objects by their "RuleID" key.
  # grep -c prints 0 and exits 1 on no match, so swallow the status.
  finding_count=0
  if [[ -s "${report_file}" ]]; then
    finding_count="$(grep -c '"RuleID"' "${report_file}" || true)"
  fi

  repos_scanned=$((repos_scanned + 1))
  if ((finding_count > 0)); then
    printf '%-50s %s\n' "${repo_name}" "${finding_count}"
    total_findings=$((total_findings + finding_count))
    repos_with_findings=$((repos_with_findings + 1))
  fi
done < <(_find_repos)

printf '%s\n' "----"
printf 'Scanned %s repo(s) under: %s\n' "${repos_scanned}" "${base_dir}"
printf 'Findings: %s across %s repo(s)\n' "${total_findings}" "${repos_with_findings}"
printf 'Reports:  %s\n' "${report_dir}"

if ((total_findings > 0)); then
  printf '\n%s\n' "Review flagged repos above. Inspect a report with:"
  printf '  python3 -m json.tool %s/<repo>.json\n' "${report_dir}"
  exit 1
fi

printf '%s\n' "No secrets found."
exit 0
