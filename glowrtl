#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

usage() {
    cat <<'EOF'
Usage: glowrtl [-w WIDTH] FILE...

Render markdown with glow, reordered for RTL reading with styling preserved.
Equivalent to: glow -s dark -w WIDTH FILE... | bidi_glow

  -w WIDTH   word-wrap width (default: current terminal width via `tput cols`)
  -h         show this help
EOF
}

width=""
while getopts ":w:h" opt; do
    case "${opt}" in
        w) width="${OPTARG}" ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

width="${width:-$(tput cols)}"

glow -s dark -w "${width}" "$@" | bidi_glow
