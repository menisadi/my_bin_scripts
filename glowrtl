#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

usage() {
    cat <<'EOF'
Usage: glowrtl [-w WIDTH] [-p] FILE...

Render markdown with glow, reordered for RTL reading with styling preserved.
Equivalent to: glow -s dark -w WIDTH FILE... | bidi_glow

  -w WIDTH   word-wrap width (default: current terminal width via `tput cols`)
  -p         page the output through `less -R`
  -h         show this help
EOF
}

width=""
use_pager=0
while getopts ":w:ph" opt; do
    case "${opt}" in
        w) width="${OPTARG}" ;;
        p) use_pager=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

width="${width:-$(tput cols)}"

if [[ "${use_pager}" -eq 1 ]]; then
    glow -s dark -w "${width}" "$@" | bidi_glow | less -R
else
    glow -s dark -w "${width}" "$@" | bidi_glow
fi
