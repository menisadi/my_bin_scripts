#!/usr/bin/env bash
#
# callrm - remove a call recording, its transcript and its metadata sidecar
#          together, with a confirmation prompt, then refresh the index.
#
#          The index (calls.db and the rendered index.md) is derived from the
#          sidecars by callindex, so there is no index row to edit here:
#          deleting the files and rebuilding is both simpler and impossible to
#          get out of step. Matching is done by exact basename rather than a
#          find glob, because recorder-produced names are bracketed
#          ("[Contact]_[Phone]_...") and find would read "[1455]" as a
#          character class matching a single one of "1", "4" or "5" - which
#          silently matched nothing at all.
#
set -euo pipefail
IFS=$'\n\t'

readonly PROGRAM_NAME="${0##*/}"

calls_dir="${CALLRM_CALLS_DIR:-${HOME}/Recordings/calls}"

force="false"
permanent="false"
dry_run="false"
skip_index="false"
quiet="false"

_warn() { printf '%s\n' "$*" >&2; }
_die() { _warn "${PROGRAM_NAME}: $*"; exit 1; }
_info() { [[ "${quiet}" == "true" ]] || _warn "$*"; }

usage() {
  cat <<EOF
Usage: ${PROGRAM_NAME} [options] <name> [name...]

Remove a call recording, its transcript, its .srt (if any) and its JSON
metadata sidecar - together, in one step - then rebuild the index so it no
longer lists the call.

<name> is the shared base name across "<name>.opus" (or whichever
extension), "<name>.txt" and "<name>.json". It can also be given as a full
path to any of them; the extension is stripped.

By default, matched files are moved to the trash (recoverable), not
permanently deleted, and you are asked to confirm before anything happens.

Options:
      --permanent    Permanently delete instead of moving to the trash
  -f, --force        Do not ask for confirmation
      --dry-run      Show what would be removed without removing anything
      --no-index     Skip the index rebuild
  -q, --quiet        Suppress progress messages
  -h, --help         Show this help

Environment:
  CALLRM_CALLS_DIR   Directory to search for matching files (default: ${calls_dir})
EOF
}

_require() {
  local tool
  for tool in "$@"; do
    command -v "${tool}" >/dev/null 2>&1 || _die "required tool not found: ${tool}"
  done
}

_base_name() {
  local input="$1" name
  name="${input##*/}"
  name="${name%.*}"
  printf '%s\n' "${name}"
}

# Every file in the calls directory whose name, minus its extension, is
# exactly the given base name. An exact string comparison, so brackets and
# Hebrew in the name are matched literally.
_matching_files() {
  local base_name="$1" candidate candidate_name
  while IFS= read -r -d '' candidate; do
    candidate_name="${candidate##*/}"
    if [[ "${candidate_name%.*}" == "${base_name}" ]]; then
      printf '%s\0' "${candidate}"
    fi
  done < <(find "${calls_dir}" -maxdepth 1 -type f -print0)
}

# The call's topic tag, for the confirmation preview, read from its sidecar.
_call_tag() {
  local base_name="$1"
  local sidecar="${calls_dir}/${base_name}.json"
  [[ -f "${sidecar}" ]] || return 0
  jq -r '
    [(.tag.general // ""), ((.tag.specific // []) | join(", "))]
    | map(select(. != "")) | join(", ")
  ' "${sidecar}" 2>/dev/null || true
}

_confirm() {
  local prompt="$1" reply
  [[ "${force}" == "true" ]] && return 0
  read -r -p "${prompt} [y/N] " reply || reply=""
  [[ "${reply}" =~ ^[Yy]$ ]]
}

remove_one() {
  local input="$1"
  local base_name tag file
  local -a files=()

  base_name="$(_base_name "${input}")"

  while IFS= read -r -d '' file; do
    files+=("${file}")
  done < <(_matching_files "${base_name}")

  if [[ "${#files[@]}" -eq 0 ]]; then
    _die "nothing found for '${base_name}'"
  fi

  tag="$(_call_tag "${base_name}")"

  _info "${base_name}:"
  [[ -n "${tag}" ]] && _info "  topic: ${tag}"
  for file in "${files[@]}"; do
    _info "  file:  ${file}"
  done

  if [[ "${dry_run}" == "true" ]]; then
    return 0
  fi

  _confirm "Remove the above?" || { _info "skipped ${base_name}"; return 0; }

  for file in "${files[@]}"; do
    if [[ "${permanent}" == "true" ]]; then
      rm -f "${file}"
    else
      trash "${file}"
    fi
  done

  _info "removed ${base_name}"
  return 0
}

main() {
  local -a names=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --permanent) permanent="true"; shift ;;
      -f|--force) force="true"; shift ;;
      --dry-run) dry_run="true"; shift ;;
      --no-index) skip_index="true"; shift ;;
      -q|--quiet) quiet="true"; shift ;;
      --) shift; break ;;
      -*) _die "unknown option: $1 (try --help)" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  while [[ $# -gt 0 ]]; do
    names+=("$1")
    shift
  done

  if [[ "${#names[@]}" -eq 0 ]]; then
    usage
    exit 1
  fi

  _require find jq
  [[ "${permanent}" == "true" ]] || _require trash
  [[ "${skip_index}" == "true" || "${dry_run}" == "true" ]] || _require callindex

  local name
  for name in "${names[@]}"; do
    remove_one "${name}"
  done

  local -a extra_flags=()
  [[ "${quiet}" == "true" ]] && extra_flags+=(-q)

  if [[ "${dry_run}" == "false" && "${skip_index}" == "false" ]]; then
    callindex "${extra_flags[@]+"${extra_flags[@]}"}"
    callindex "${extra_flags[@]+"${extra_flags[@]}"}" --markdown
  fi
}

main "$@"
# vim: ft=sh
