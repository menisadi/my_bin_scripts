#!/usr/bin/env bash
#
# calltopic - generate a short Hebrew topic tag for a call transcript (as
#             written by callscribe) and append it to a searchable index.
#
set -euo pipefail
IFS=$'\n\t'

readonly PROGRAM_NAME="${0##*/}"

model_path_he="${CALLTOPIC_MODEL_HE:-${HOME}/.local/share/mlx/DictaLM-3.0-1.7B-Instruct-bf16}"
model_path_en="${CALLTOPIC_MODEL_EN:-mlx-community/Qwen3-4B-4bit-DWQ-053125}"
model_path="${CALLTOPIC_MODEL:-}"
calls_dir="${CALLTOPIC_CALLS_DIR:-${HOME}/Recordings/calls}"
index_path="${CALLTOPIC_INDEX:-${calls_dir}/index.md}"
max_tokens="${CALLTOPIC_MAX_TOKENS:-25}"
lang="${CALLTOPIC_LANG:-he}"

use_latest="false"
dry_run="false"
quiet="false"

# Locked in after comparing models/prompts on real transcripts: a short,
# example-anchored instruction keeps output to an actual tag instead of a
# full sentence, which longer "tagline" framings failed to do reliably.
readonly PROMPT_PREFIX_HE="תן תגית נושא קצרה לשיחה הבאה (עד 5 מילים, לא משפט, בלי הסברים). לדוגמה: 'תיאום מפגש', 'תקלה בקוד', 'שיחת חולין'.

שיחה:
"

readonly PROMPT_PREFIX_EN="Give a short topic tag for the following call transcript (up to 5 words, not a sentence, no explanations). Example: 'sync meeting', 'code bug', 'casual chat'.

Transcript:
"

_warn() { printf '%s\n' "$*" >&2; }
_die() { _warn "${PROGRAM_NAME}: $*"; exit 1; }
_info() { [[ "${quiet}" == "true" ]] || _warn "$*"; }

usage() {
  cat <<EOF
Usage: ${PROGRAM_NAME} [options] <transcript.txt|recording>
       ${PROGRAM_NAME} [options] --last

Generate a short Hebrew topic tag for a call transcript (written by
callscribe) using a local model, and append it to a markdown index.

If given a recording path instead of a .txt file, the transcript is assumed
to sit next to it with the same base name (as callscribe writes it).

Options:
  -m, --model PATH   MLX model to use (overrides --lang's default model)
  -l, --lang LANG    Transcript/tag language: he or en (default: ${lang})
      --index PATH   Markdown index file to append to (default: ${index_path})
      --last         Use the newest transcript in the calls directory
      --dry-run      Print the tag without touching the index
  -q, --quiet        Suppress progress messages
  -h, --help         Show this help

Environment:
  CALLTOPIC_MODEL       MLX model path, overrides --lang's default entirely
  CALLTOPIC_MODEL_HE    Default MLX model for --lang he (default: ${model_path_he})
  CALLTOPIC_MODEL_EN    Default MLX model for --lang en (default: ${model_path_en})
  CALLTOPIC_LANG        Default --lang value (default: he)
  CALLTOPIC_CALLS_DIR   Directory searched by --last (default: ${calls_dir})
  CALLTOPIC_INDEX       Default index file path
  CALLTOPIC_MAX_TOKENS  Generation token budget (default: ${max_tokens})
EOF
}

_require() {
  local tool
  for tool in "$@"; do
    command -v "${tool}" >/dev/null 2>&1 || _die "required tool not found: ${tool}"
  done
}

_newest_transcript() {
  local directory="$1"
  [[ -d "${directory}" ]] || _die "calls directory not found: ${directory}"

  local -a stat_command
  if stat -f '%m %N' . >/dev/null 2>&1; then
    stat_command=(stat -f '%m %N')
  else
    stat_command=(stat -c '%Y %n')
  fi

  find "${directory}" -type f -iname '*.txt' -print0 2>/dev/null \
    | xargs -0 "${stat_command[@]}" 2>/dev/null \
    | sort -rn \
    | head -n 1 \
    | cut -d' ' -f2-
}

# Strip markdown bold, wrapping quotes, and a leading "תגית נושא:"/"Topic:"-style
# prefix that the model sometimes adds despite the prompt's instructions.
_clean_tag() {
  sed -E "
    s/^[[:space:]]+//
    s/[[:space:]]+\$//
    s/\*//g
    s/^[[:space:]]+//
    s/[[:space:]]+\$//
    s/^['\"]//
    s/['\"]\$//
    s/^(תגית נושא|נושא השיחה|נושא|שיחה|[Tt]opic tag|[Tt]opic)[[:space:]]*:[[:space:]]*//
    s/^['\"]//
    s/['\"]\$//
    s/^[[:space:]]+//
    s/[[:space:]]+\$//
  "
}

generate_tag() {
  local transcript_file="$1"
  local prompt tag prompt_prefix

  case "${lang}" in
    en) prompt_prefix="${PROMPT_PREFIX_EN}" ;;
    *) prompt_prefix="${PROMPT_PREFIX_HE}" ;;
  esac

  prompt="${prompt_prefix}$(cat "${transcript_file}")"

  tag="$(mlx_lm.generate \
    --model "${model_path}" \
    --max-tokens "${max_tokens}" \
    --chat-template-config '{"enable_thinking": false}' \
    --prompt "${prompt}" 2>/dev/null \
    | sed -n '/^==========$/,/^==========$/p' \
    | sed '1d;$d' \
    | _clean_tag)"

  [[ -n "${tag}" ]] || _die "model produced no output for ${transcript_file}"
  printf '%s\n' "${tag}"
}

_append_to_index() {
  local recording_name="$1" tag="$2"
  local recording_date

  recording_date="$(date +%Y-%m-%d)"

  if [[ ! -f "${index_path}" ]]; then
    mkdir -p "$(dirname "${index_path}")"
    printf '| Date | File | Topic |\n|------|------|-------|\n' >"${index_path}"
  fi

  printf '| %s | %s | %s |\n' "${recording_date}" "${recording_name}" "${tag}" >>"${index_path}"
}

process_transcript() {
  local transcript_file="$1"
  local base_name tag

  [[ -f "${transcript_file}" ]] || _die "no such file: ${transcript_file}"

  base_name="${transcript_file##*/}"
  base_name="${base_name%.txt}"

  _info "${base_name}: generating topic tag"
  tag="$(generate_tag "${transcript_file}")"

  if [[ "${dry_run}" == "true" ]]; then
    printf '%s\n' "${tag}"
    return 0
  fi

  _append_to_index "${base_name}" "${tag}"
  _info "${base_name}: ${tag}"
  _info "appended to ${index_path}"
}

main() {
  local -a inputs=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      -m|--model) model_path="${2:?--model needs a path}"; shift 2 ;;
      -l|--lang) lang="${2:?--lang needs he or en}"; shift 2 ;;
      --index) index_path="${2:?--index needs a path}"; shift 2 ;;
      --last) use_latest="true"; shift ;;
      --dry-run) dry_run="true"; shift ;;
      -q|--quiet) quiet="true"; shift ;;
      --) shift; break ;;
      -*) _die "unknown option: $1 (try --help)" ;;
      *) inputs+=("$1"); shift ;;
    esac
  done
  while [[ $# -gt 0 ]]; do
    inputs+=("$1")
    shift
  done

  _require mlx_lm.generate sed find xargs stat

  if [[ "${use_latest}" == "true" ]]; then
    local latest
    latest="$(_newest_transcript "${calls_dir}")"
    [[ -n "${latest}" ]] || _die "no transcripts found in ${calls_dir}"
    inputs+=("${latest}")
  fi

  if [[ "${#inputs[@]}" -eq 0 ]]; then
    usage
    exit 1
  fi

  case "${lang}" in
    he|en) ;;
    *) _die "unsupported language: ${lang} (expected he or en)" ;;
  esac

  if [[ -z "${model_path}" ]]; then
    if [[ "${lang}" == "en" ]]; then
      model_path="${model_path_en}"
    else
      model_path="${model_path_he}"
    fi
  fi

  # A local filesystem path must exist; a bare "org/repo" HF id is left for
  # mlx_lm.generate to resolve from its own cache.
  if [[ "${model_path}" == /* || "${model_path}" == .* ]]; then
    [[ -d "${model_path}" || -f "${model_path}" ]] || _die "model not found: ${model_path}"
  fi

  local input transcript_file
  for input in "${inputs[@]}"; do
    transcript_file="${input}"
    if [[ "${input}" != *.txt ]]; then
      transcript_file="${input%.*}.txt"
    fi
    process_transcript "${transcript_file}"
  done
}

main "$@"
# vim: ft=sh
