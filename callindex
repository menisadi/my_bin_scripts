#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
#
# callindex - build and query a SQLite index over the call archive.
#
# The index is entirely derived from the JSON sidecars (written by callmeta
# and calltopic) plus the transcript text, so it is disposable: delete the
# database and rebuild it, and nothing is lost. That is the whole point of
# keeping the files as the source of truth - the index can be changed,
# re-tokenized or thrown away without ever risking the archive.
#
# Full-text search uses FTS5 with the trigram tokenizer rather than the
# default unicode61. Hebrew glues prefixes onto words (ה/ו/ב/ל/מ/ש) and has
# no stemmer in SQLite, so whole-token matching misses far too much: a search
# for "תקלה" would not find "בתקלה". Trigram indexing matches substrings, at
# the cost of needing at least 3 characters per query term.
#
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path

PROGRAM_NAME = "callindex"

CALLS_DIR = Path(
    os.environ.get("CALLINDEX_CALLS_DIR", str(Path.home() / "Recordings" / "calls"))
)
DB_PATH = Path(os.environ.get("CALLINDEX_DB", str(CALLS_DIR / "calls.db")))
MARKDOWN_PATH = Path(os.environ.get("CALLINDEX_MARKDOWN", str(CALLS_DIR / "index.md")))

SCHEMA = """
CREATE TABLE calls (
    base             TEXT PRIMARY KEY,
    contact          TEXT NOT NULL DEFAULT '',
    phone            TEXT,
    phone_raw        TEXT,
    direction        TEXT NOT NULL DEFAULT 'unknown',
    started_at       TEXT NOT NULL DEFAULT '',
    date             TEXT NOT NULL DEFAULT '',
    time             TEXT NOT NULL DEFAULT '',
    duration_seconds REAL,
    channels         INTEGER,
    tag              TEXT NOT NULL DEFAULT '',
    tag_general      TEXT NOT NULL DEFAULT '',
    tag_specific     TEXT NOT NULL DEFAULT '[]',
    scribe_status    TEXT NOT NULL DEFAULT 'missing',
    scribe_words     INTEGER,
    topic_status     TEXT NOT NULL DEFAULT 'missing',
    recording        TEXT,
    transcript       TEXT,
    path             TEXT NOT NULL
);
CREATE INDEX calls_date ON calls(date DESC);
CREATE INDEX calls_phone ON calls(phone);
CREATE INDEX calls_contact ON calls(contact);

CREATE VIRTUAL TABLE search USING fts5(
    base UNINDEXED,
    contact,
    tag,
    body,
    tokenize='trigram'
);
"""


def _warn(message: str) -> None:
    print(message, file=sys.stderr)


def _die(message: str) -> None:
    _warn(f"{PROGRAM_NAME}: {message}")
    sys.exit(1)


def _info(quiet: bool, message: str) -> None:
    if not quiet:
        _warn(message)


def render_tag(tag: dict) -> str:
    parts = [str(tag.get("general", "")).strip()]
    parts.extend(str(item).strip() for item in tag.get("specific") or [])
    return ", ".join(part for part in parts if part)


def sidecars(calls_dir: Path) -> list[Path]:
    if not calls_dir.is_dir():
        _die(f"calls directory not found: {calls_dir}")
    return sorted(calls_dir.rglob("*.json"))


def load_row(sidecar_path: Path) -> dict | None:
    try:
        data = json.loads(sidecar_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        _warn(f"{PROGRAM_NAME}: skipping malformed sidecar {sidecar_path.name}: {exc}")
        return None
    if not isinstance(data, dict) or not data.get("base"):
        _warn(f"{PROGRAM_NAME}: skipping {sidecar_path.name}: not a call sidecar")
        return None

    stages = data.get("stages") or {}
    scribe = stages.get("scribe") or {}
    topic = stages.get("topic") or {}
    tag = data.get("tag") or {}

    transcript_name = data.get("transcript")
    body = ""
    if transcript_name:
        transcript_path = sidecar_path.with_name(transcript_name)
        if transcript_path.is_file():
            body = transcript_path.read_text(encoding="utf-8")

    return {
        "base": data["base"],
        "contact": data.get("contact") or "",
        "phone": data.get("phone"),
        "phone_raw": data.get("phone_raw"),
        "direction": data.get("direction") or "unknown",
        "started_at": data.get("started_at") or "",
        "date": data.get("date") or "",
        "time": data.get("time") or "",
        "duration_seconds": data.get("duration_seconds"),
        "channels": data.get("channels"),
        "tag": render_tag(tag),
        "tag_general": str(tag.get("general", "")).strip(),
        "tag_specific": json.dumps(tag.get("specific") or [], ensure_ascii=False),
        "scribe_status": scribe.get("status") or "missing",
        "scribe_words": scribe.get("words"),
        "topic_status": topic.get("status") or "missing",
        "recording": data.get("recording"),
        "transcript": transcript_name,
        "path": str(sidecar_path.parent),
        "body": body,
    }


def build(db_path: Path, calls_dir: Path, quiet: bool) -> int:
    """Rebuild the whole index from scratch.

    A full rebuild rather than an incremental sync: the archive is small
    enough that this takes well under a second, and it removes any chance of
    the index drifting from the sidecars (a deleted call leaving a stale row,
    a re-tagged call keeping its old tag).
    """
    rows = [row for row in (load_row(p) for p in sidecars(calls_dir)) if row]

    db_path.parent.mkdir(parents=True, exist_ok=True)
    temp_path = db_path.with_name(f".{db_path.name}.tmp")
    temp_path.unlink(missing_ok=True)

    connection = sqlite3.connect(temp_path)
    try:
        with connection:
            connection.executescript(SCHEMA)
            connection.executemany(
                """
                INSERT INTO calls (
                    base, contact, phone, phone_raw, direction, started_at,
                    date, time, duration_seconds, channels, tag, tag_general,
                    tag_specific, scribe_status, scribe_words, topic_status,
                    recording, transcript, path
                ) VALUES (
                    :base, :contact, :phone, :phone_raw, :direction, :started_at,
                    :date, :time, :duration_seconds, :channels, :tag, :tag_general,
                    :tag_specific, :scribe_status, :scribe_words, :topic_status,
                    :recording, :transcript, :path
                )
                """,
                rows,
            )
            connection.executemany(
                "INSERT INTO search (base, contact, tag, body) "
                "VALUES (:base, :contact, :tag, :body)",
                rows,
            )
    finally:
        connection.close()

    os.replace(temp_path, db_path)

    untagged = sum(1 for row in rows if row["topic_status"] != "ok")
    unscribed = sum(1 for row in rows if row["scribe_status"] != "ok")
    _info(quiet, f"indexed {len(rows)} calls into {db_path}")
    if unscribed:
        _info(quiet, f"  {unscribed} without a transcript (callscribe not run/failed)")
    if untagged:
        _info(quiet, f"  {untagged} without a topic tag (calltopic not run/failed)")
    return 0


def connect(db_path: Path) -> sqlite3.Connection:
    if not db_path.is_file():
        _die(f"index not found: {db_path} (run {PROGRAM_NAME} with no arguments first)")
    connection = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    return connection


def filter_clauses(args: argparse.Namespace) -> tuple[list[str], list[object]]:
    clauses: list[str] = []
    params: list[object] = []
    if args.contact:
        clauses.append(
            "(calls.contact LIKE ? OR calls.phone LIKE ? OR calls.phone_raw LIKE ?)"
        )
        params.extend([f"%{args.contact}%"] * 3)
    if args.direction:
        clauses.append("calls.direction = ?")
        params.append(args.direction)
    if args.since:
        clauses.append("calls.date >= ?")
        params.append(args.since)
    if args.until:
        clauses.append("calls.date <= ?")
        params.append(args.until)
    if args.untagged:
        clauses.append("calls.topic_status != 'ok'")
    return clauses, params


def format_duration(seconds: float | None) -> str:
    if not seconds:
        return "--:--"
    total = int(seconds)
    return f"{total // 60:02d}:{total % 60:02d}"


def print_rows(rows: list[sqlite3.Row], show_snippet: bool) -> None:
    if not rows:
        _warn("no matching calls")
        return
    for row in rows:
        direction = {"in": "<-", "out": "->"}.get(row["direction"], " ?")
        print(
            f"{row['date']} {row['time'][:5]} {direction} "
            f"{row['contact'] or row['phone_raw'] or '?'} "
            f"({format_duration(row['duration_seconds'])})  {row['tag']}"
        )
        print(f"    {row['base']}")
        if show_snippet and row["snippet"]:
            snippet = " ".join(row["snippet"].split())
            print(f"    {snippet}")


def as_fts_query(query: str) -> str:
    """Wrap a raw query as a single FTS5 phrase.

    Users type Hebrew phrases with punctuation, apostrophes and quotes, all of
    which are FTS5 query operators. Quoting the whole thing turns it into a
    literal phrase search, which is what "search my calls for X" means anyway.
    """
    escaped = query.replace('"', '""')
    return f'"{escaped}"'


def search(db_path: Path, args: argparse.Namespace) -> int:
    if len(args.search.strip()) < 3:
        _die("trigram search needs at least 3 characters")

    clauses, params = filter_clauses(args)
    where = " AND ".join(["search MATCH ?"] + clauses)
    connection = connect(db_path)
    try:
        rows = connection.execute(
            f"""
            SELECT calls.*,
                   snippet(search, 3, '[', ']', ' … ', 16) AS snippet
            FROM search
            JOIN calls ON calls.base = search.base
            WHERE {where}
            ORDER BY bm25(search), calls.date DESC
            LIMIT ?
            """,
            [as_fts_query(args.search), *params, args.limit],
        ).fetchall()
    except sqlite3.OperationalError as exc:
        _die(f"search failed: {exc}")
    finally:
        connection.close()

    print_rows(rows, show_snippet=True)
    return 0


def listing(db_path: Path, args: argparse.Namespace) -> int:
    clauses, params = filter_clauses(args)
    where = f"WHERE {' AND '.join(clauses)}" if clauses else ""
    connection = connect(db_path)
    try:
        rows = connection.execute(
            f"SELECT calls.*, NULL AS snippet FROM calls {where} "
            "ORDER BY calls.date DESC, calls.time DESC LIMIT ?",
            [*params, args.limit],
        ).fetchall()
    finally:
        connection.close()

    print_rows(rows, show_snippet=False)
    return 0


def render_markdown(db_path: Path, markdown_path: Path, quiet: bool) -> int:
    """Regenerate the human-readable markdown index as a view of the database.

    Kept because a plain scannable table is genuinely useful, but it is now
    derived output: chronologically sorted, never duplicated, and safe to
    delete. Pipe characters in a tag are escaped so a topic can't break the
    table.
    """
    connection = connect(db_path)
    try:
        rows = connection.execute(
            "SELECT * FROM calls ORDER BY date DESC, time DESC"
        ).fetchall()
    finally:
        connection.close()

    lines = [
        "| Date | Time | Dir | Contact | Phone | Length | File | Topic |",
        "|------|------|-----|---------|-------|--------|------|-------|",
    ]
    for row in rows:
        direction = {"in": "in", "out": "out"}.get(row["direction"], "")
        tag = row["tag"].replace("|", "\\|")
        lines.append(
            f"| {row['date']} | {row['time']} | {direction} | {row['contact']} | "
            f"{row['phone'] or row['phone_raw'] or ''} | "
            f"{format_duration(row['duration_seconds'])} | {row['base']} | {tag} |"
        )
    markdown_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    _info(quiet, f"wrote {len(rows)} rows to {markdown_path}")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=PROGRAM_NAME,
        description=(
            "Build and query a SQLite index over the call archive. With no "
            "options, rebuilds the index from the JSON sidecars and transcripts."
        ),
        epilog=(
            "Examples:\n"
            "  callindex                          rebuild the index\n"
            "  callindex -s 'תקלה במערכת'          full-text search the transcripts\n"
            "  callindex -l --contact 0525252145  list one contact's calls\n"
            "  callindex -l --untagged            find calls calltopic never tagged\n"
            "  callindex --markdown               regenerate index.md from the index\n\n"
            "Full-text search is substring-based (FTS5 trigram), so queries need\n"
            "at least 3 characters and Hebrew prefixes do not hide matches.\n\n"
            "Environment:\n"
            f"  CALLINDEX_CALLS_DIR   Archive directory (default: {CALLS_DIR})\n"
            f"  CALLINDEX_DB          Index database (default: {DB_PATH})\n"
            f"  CALLINDEX_MARKDOWN    Rendered markdown index (default: {MARKDOWN_PATH})"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-s", "--search", help="full-text search across transcripts")
    parser.add_argument(
        "-l", "--list", action="store_true", help="list calls instead of rebuilding"
    )
    parser.add_argument(
        "--markdown",
        nargs="?",
        const=str(MARKDOWN_PATH),
        help=f"regenerate the markdown index (default: {MARKDOWN_PATH})",
    )
    parser.add_argument("--contact", help="filter by contact name, or phone substring")
    parser.add_argument(
        "--direction", choices=["in", "out", "unknown"], help="filter by direction"
    )
    parser.add_argument("--since", help="only calls on or after YYYY-MM-DD")
    parser.add_argument("--until", help="only calls on or before YYYY-MM-DD")
    parser.add_argument(
        "--untagged", action="store_true", help="only calls with no topic tag"
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=50,
        help="maximum rows to show (default: %(default)s)",
    )
    parser.add_argument("--db", type=Path, default=DB_PATH, help="index database path")
    parser.add_argument(
        "-q", "--quiet", action="store_true", help="suppress progress messages"
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)

    if args.search:
        return search(args.db, args)
    if args.list:
        return listing(args.db, args)
    if args.markdown:
        return render_markdown(args.db, Path(args.markdown), args.quiet)
    return build(args.db, CALLS_DIR, args.quiet)


if __name__ == "__main__":
    sys.exit(main())
